# LabelBench configuration.
#
# Copy to .env and edit. Read by docker compose and by the app container.

# The hostname workstations open. Must match a SAN in the server certificate.
#   labelbench.local  — recommended: resolved over mDNS, no per-machine DNS setup.
LABELBENCH_HOST=labelbench.local

# Where the data lives. The SQLite file and the asset directory together are
# the entire backup.
LABELBENCH_DATA_DIR=./data
LABELBENCH_DB_PATH=./data/labelbench.db
LABELBENCH_ASSET_DIR=./data/assets

# Phase 1 runs open on the trusted LAN: no auth, all templates shared.
# The seam for later is already in place — set the mode to apikey and provide
# a key, and the API starts requiring `x-api-key`.
LABELBENCH_AUTH_MODE=none
# LABELBENCH_API_KEY=

# Log level for the API server.
LOG_LEVEL=info
