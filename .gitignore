# --- LabelBench ---

# Runtime data: the SQLite file and the asset directory. This is the entire
# backup, but it is not source.
data/
*.db
*.db-wal
*.db-shm

# TLS material. The certificate is regenerable from the mkcert CA; the private
# key and the CA root must never enter the repository.
deploy/caddy/certs/*.pem
!deploy/caddy/certs/.gitkeep

# Local configuration. .env.example is the tracked template.
.env

# Locally staged tooling binaries.
tools/bin/

# --- Node ---
node_modules/
dist/
*.tsbuildinfo

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# Backups taken by scripts/backup.sh. They are copies of the database and
# the assets, not source.
backups/

# Scratch directories used while working out a geometry problem.
.probe/
.web/

# LibreOffice leaves a lock file beside any spreadsheet it has open.
.~lock.*#
