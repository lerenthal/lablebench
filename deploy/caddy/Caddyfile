# LabelBench — Caddy TLS termination
#
# TLS is terminated here, in front of the LabelBench app.
#
# The certificates come from an internal CA generated with mkcert (see
# scripts/setup-certs.sh). Each workstation trusts that root CA once — without a
# browser-trusted HTTPS origin, navigator.bluetooth and navigator.serial are
# unavailable and printing cannot work at all.
#
# This file is mounted read-only into the Caddy container; the certs are
# mounted from deploy/caddy/certs.

{
	# No email, no ACME — this is a fully offline LAN.
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

# The label-design SPA and the API live behind the same origin, so the browser
# sees a single trusted origin and one certificate.
#
# The site answers for BOTH the hostname and the server's LAN address, in one
# site block on purpose:
#
#   - A workstation that cannot resolve the mDNS name across a switch can
#     still reach the server by address. The certificate carries the IP as a
#     SAN.
#   - Two separate site blocks would leave Caddy with two candidates for a
#     TLS handshake that carries no SNI, and it fails the handshake with
#     "internal error" instead of choosing. One site with two addresses
#     always has exactly one candidate, and the Host header still routes
#     correctly.
#
# The bare `:443` address makes this site the catch-all for the port, so a
# ClientHello with no SNI still gets a certificate. Chrome does not send SNI
# for an IP address, and curl never does, so without this the IP path fails
# the handshake outright.
{$LABELBENCH_HOST:labelbench.local}, {$LABELBENCH_IP:10.10.17.185}, :443 {
	encode zstd gzip

	tls /certs/labelbench.pem /certs/labelbench-key.pem

	header {
		# The app is entirely local; nothing should be embedded cross-origin.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The root CA is published so a new workstation can trust the origin in one
	# command, instead of copying a file around by hand:
	#
	#   curl -k https://labelbench.local/rootCA.pem -o rootCA.pem
	#   openssl x509 -in rootCA.pem -noout -fingerprint -sha256
	#   sudo cp rootCA.pem /usr/local/share/ca-certificates/labelbench-rootCA.crt
	#   sudo update-ca-certificates
	#
	# Only the CA's public certificate is served. Its private key stays in
	# ~/.local/share/mkcert/ on the server and is never copied here.
	handle /rootCA.pem {
		root * /certs
		rewrite * /rootCA.pem
		file_server
	}

	# Proxy the API to the LabelBench server.
	handle /api/* {
		reverse_proxy app:3000
	}

	# Everything else is the SPA.
	handle {
		reverse_proxy app:3000
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP exists only to redirect to HTTPS.
http://{$LABELBENCH_HOST:labelbench.local}, http://{$LABELBENCH_IP:10.10.17.185} {
	redir https://{host}{uri} permanent
}
