# LabelBench — Caddy TLS termination
#
# TLS is terminated here, in front of the LabelBench app.
#
# The certificates come from an internal CA generated with mkcert (see
# scripts/setup-certs.sh). Each workstation trusts that root CA once — without a
# browser-trusted HTTPS origin, navigator.bluetooth and navigator.serial are
# unavailable and printing cannot work at all.
#
# This file is mounted read-only into the Caddy container, as part of the
# deploy/caddy directory. The certs sit next to it in deploy/caddy/certs.

{
	# No email, no ACME — this is a fully offline LAN.
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

# The label-design SPA and the API live behind the same origin, so the browser
# sees a single trusted origin and one certificate.
#
# The site answers for BOTH the hostname and the server's LAN address, in one
# site block on purpose:
#
#   - A workstation that cannot resolve the mDNS name across a switch can
#     still reach the server by address. The certificate carries the IP as a
#     SAN.
#   - Two separate site blocks would leave Caddy with two candidates for a
#     TLS handshake that carries no SNI, and it fails the handshake with
#     "internal error" instead of choosing. One site with two addresses
#     always has exactly one candidate, and the Host header still routes
#     correctly.
#
# The bare `:443` address makes this site the catch-all for the port, so a
# ClientHello with no SNI still gets a certificate. Chrome does not send SNI
# for an IP address, and curl never does, so without this the IP path fails
# the handshake outright.
{$LABELBENCH_HOST:labelbench.local}, {$LABELBENCH_IP:10.10.17.185}, :443 {
	encode zstd gzip

	tls /etc/caddy/lab/certs/labelbench.pem /etc/caddy/lab/certs/labelbench-key.pem

	header {
		# The app is entirely local; nothing should be embedded cross-origin.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server

		# The app loads nothing from anywhere else. The one exception is the
		# ZPL preview, which renders a label through an outside service, and
		# that is the user's own label going to it — so it is named rather
		# than the whole outside world being allowed.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.labelary.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
	}

	# The root CA is published so a new workstation can trust the origin in one
	# command, instead of copying a file around by hand:
	#
	#   curl -k https://labelbench.local/rootCA.pem -o rootCA.pem
	#   openssl x509 -in rootCA.pem -noout -fingerprint -sha256
	#   sudo cp rootCA.pem /usr/local/share/ca-certificates/labelbench-rootCA.crt
	#   sudo update-ca-certificates
	#
	# Only the CA's public certificate is served. Its private key stays in
	# ~/.local/share/mkcert/ on the server and is never copied here.
	handle /rootCA.pem {
		root * /etc/caddy/lab/certs
		rewrite * /rootCA.pem
		file_server
	}

	# Proxy the API to the LabelBench server.
	handle /api/* {
		reverse_proxy app:3000
	}

	# Everything else is the SPA.
	handle {
		reverse_proxy app:3000
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP is the way in.
#
# Each address redirects to its OWN HTTPS counterpart. A workstation that
# reached the server by address must not be sent to the hostname: a machine
# that cannot resolve the mDNS name across a switch would be sent to a name
# it cannot resolve, and the server — which was reachable by address a
# moment earlier — would look broken.
#
# The redirect names the external HTTPS port explicitly. {host} would carry
# the HTTP port the client actually reached, and redirecting to that would
# send the browser to a plain-HTTP port over HTTPS.
#
# Two things are served here rather than redirected, because a workstation
# that cannot trust the certificate yet has nowhere else to go:
#
#   - the root CA, so the certificate can be fetched before it is trusted
#   - a setup page, which says what to do and carries the commands to do it
(setup) {
	route {
		# The CA's public certificate is not a secret — publishing it is the
		# point of having one.
		handle /rootCA.pem {
			root * /etc/caddy/lab/certs
			rewrite * /rootCA.pem
			file_server
		}

		# The setup page, with the addresses of this deployment filled in.
		#
		# The templates module is part of Caddy itself, and it rewrites the
		# file as it is written — so the page carries the real address of
		# this server rather than a placeholder someone has to fill in.
		handle /setup* {
			root * /etc/caddy/lab
			rewrite * /setup.html
			templates
			file_server
		}

		# The plain address lands on the setup page rather than on a
		# redirect to a certificate the browser does not trust yet.
		handle / {
			root * /etc/caddy/lab
			rewrite * /setup.html
			templates
			file_server
		}

		redir https://{args[0]}:{env.LABELBENCH_HTTPS_PORT}{uri} permanent
	}
}

http://{$LABELBENCH_HOST:labelbench.local} {
	import setup {$LABELBENCH_HOST:labelbench.local}
}

http://{$LABELBENCH_IP:10.10.17.185} {
	import setup {$LABELBENCH_IP:10.10.17.185}
}
